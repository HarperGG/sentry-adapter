# Copy to .env. This file contains non-secret deployment settings only.
ADAPTER_BIND_IP=0.0.0.0
SENTRY_BASE_URL=https://sentry.gwm-adas.com
SENTRY_ORG=sentry
# Only feedback from this Sentry project is converted to a Teambition task.
SENTRY_PROJECT=anno-seg-test
# Comma-separated HTTPS hosts used by Sentry attachment redirects.
SENTRY_ATTACHMENT_REDIRECT_HOSTS=

# mock validates the pipeline without writing to Teambition.
TEAMBITION_MODE=mock
TEAMBITION_BASE_URL=https://teambition.gwm.cn
TEAMBITION_AUTH_MODE=app_token
TEAMBITION_TOKEN_URL=https://teambition.gwm.cn/gateway/appToken
TEAMBITION_TASK_PATH=/gateway/v3/task/create
TEAMBITION_UPLOAD_TOKEN_PATH=/gateway/v3/awos/upload-token
# Required for screenshots: target task type's file custom field ID.
TEAMBITION_ATTACHMENT_FIELD_ID=
# Exact origins returned as uploadUrl, e.g. https://files.example.com or http://minio:9000.
TEAMBITION_UPLOAD_ALLOWED_ORIGINS=
# In real mode, TEAMBITION_APP_ID and TEAMBITION_APP_SECRET come from
# config/credentials.env (see config/credentials.env.example).
TEAMBITION_TENANT_ID=6226ae08aa5e5cf604ea94e8
TEAMBITION_OPERATOR_ID=69e96cd7652bf1ac6daaf09e
TEAMBITION_PROJECT_ID=6735db60fcb4954ac4a35c8b
TEAMBITION_TASKLIST_ID=
TEAMBITION_STAGE_ID=
TEAMBITION_TASKFLOWSTATUS_ID=
TEAMBITION_EXECUTOR_ID=
TEAMBITION_BUG_TYPE_ID=
TEAMBITION_FEATURE_TYPE_ID=
TEAMBITION_SCENARIO_ID=6ab23468507b55725189da62
TEAMBITION_CUSTOM_FIELD_ID=69ba191630dc10c6c2e202de
TEAMBITION_CUSTOM_FIELD_OPTION_ID=69ba191630dc10c6c2e202e2
TEAMBITION_CUSTOM_FIELD_OPTION_TITLE=标注平台