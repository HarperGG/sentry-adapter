# Copy to .env. Keep Teambition AppID/AppSecret in config/credentials.env.
# Host IP for published port 8787. Set to the node's private IP when a CLB forwards to this node; 127.0.0.1 allows local access only.
ADAPTER_BIND_IP=127.0.0.1

# Sentry project slug for feedback processing (change for the target project).
SENTRY_BASE_URL=https://sentry.gwm-adas.com
SENTRY_ORG=sentry
SENTRY_PROJECT=anno-seg-test
# Reserved for later screenshot support; unused by the first-version worker.
SENTRY_ATTACHMENT_REDIRECT_HOSTS=

# Start in mock mode. compose.real.yaml overrides this to real.
TEAMBITION_MODE=mock
TEAMBITION_BASE_URL=https://teambition.gwm.cn
# Exchange AppID/AppSecret for an appToken; cache it for the returned lifetime.
TEAMBITION_AUTH_MODE=app_token
TEAMBITION_TOKEN_URL=https://teambition.gwm.cn/gateway/appToken
# HTTPS port 443 is implicit in the base URL.
TEAMBITION_TASK_PATH=/gateway/v3/task/create
# Reserved for later screenshot support; the first-version worker does not call it.
TEAMBITION_UPLOAD_TOKEN_PATH=/gateway/v3/awos/upload-token

# Task destination and v3 task/create fields. Fill IDs from your project.
TEAMBITION_TENANT_ID=
TEAMBITION_OPERATOR_ID=
TEAMBITION_PROJECT_ID=
TEAMBITION_SCENARIO_ID=
TEAMBITION_TASKLIST_ID=
TEAMBITION_STAGE_ID=
TEAMBITION_TASKFLOWSTATUS_ID=
TEAMBITION_EXECUTOR_ID=
TEAMBITION_BUG_TYPE_ID=
TEAMBITION_FEATURE_TYPE_ID=

# Optional fixed select custom field from the proven task/create request.
TEAMBITION_CUSTOM_FIELD_ID=
TEAMBITION_CUSTOM_FIELD_OPTION_ID=
TEAMBITION_CUSTOM_FIELD_OPTION_TITLE=

# Reserved for later screenshot support; leave empty in the first version.
TEAMBITION_ATTACHMENT_FIELD_ID=
TEAMBITION_UPLOAD_ALLOWED_ORIGINS=
